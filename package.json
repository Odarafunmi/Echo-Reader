{
  "name": "echo-shelf",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit",
    "check": "npm run check:scene && npm run check:scene-pause && npm run check:profiles && npm run check:theme && npm run check:theme-toggle && npm run check:voices && npm run check:pdf",
    "check:scene": "node scripts/check-scene-motion.mjs",
    "check:profiles": "node --import ./scripts/register-alias.mjs scripts/check-profiles.mjs",
    "check:theme": "node scripts/check-theme.mjs",
    "check:theme-toggle": "node scripts/check-theme-toggle.mjs",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "check:voices": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/check-voices.mjs",
    "check:pdf": "node scripts/check-pdf-parse.mjs",
    "check:scene-pause": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/check-scene-pause.mjs"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.59.0",
    "mammoth": "^1.13.0",
    "next": "^16.4.2",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
